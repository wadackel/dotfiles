{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode Go (https://opencode.ai/docs/go/)
  // 認証は `opencode auth login` または TUI 内 /connect で実施する必要あり。
  // provider prefix は実機の `opencode models` 出力に合わせて `opencode/`。
  "model": "opencode/deepseek-v4-pro",
  "small_model": "opencode/qwen3.5-plus",

  // Agentower (prefix+w) bridges opencode session events → tmux pane
  // options. Source lives in dotfiles/home/programs/opencode/plugin.ts;
  // home-manager symlinks it to ~/.config/opencode/plugin.ts. The path must
  // be absolute (file:// URL) — opencode 1.14.30 resolves relative `./` paths
  // against CWD, not opencode.json's directory, and treats them as npm-style
  // package directories looking for package.json. {env:HOME} is opencode's
  // own template substitution and is profile-independent.
  "plugin": [
    "file://{env:HOME}/.config/opencode/plugin.ts",
    "file://{env:HOME}/.config/opencode/plugins/rtk.ts"
  ],

  // opencode 1.x が自動で拾うのは AGENTS.md だけで、~/.claude/CLAUDE.md は読まない。
  // Claude 側の規則はここへ届かないので、必要なものは instructions で明示する。
  // vault-policy.md の実体は home/programs/agents/shared/ にあり、Codex は同じファイルを
  // AGENTS.md へ inline する。{env:HOME} は profile 非依存の置換で、plugin 配列と違い
  // file:// は付かない。
  "instructions": [
    "{env:HOME}/.claude/RTK.md",
    "{env:HOME}/.agents/vault-policy.md"
  ],

  // 信頼ベース: 編集・bash・webfetch は基本 allow、破壊的コマンドのみ deny。
  // opencode は最後に一致したルールが優先されるため、deny を後ろに置く。
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf .git": "deny",
      "sudo rm *": "deny",
      "sudo dd *": "deny",
      "sudo mkfs *": "deny",
      "sudo fdisk *": "deny",
      "sudo chmod 777 *": "deny",
      "sudo chown *": "deny",
      "sudo *passwd*": "deny",
      "sudo *shadow*": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "fdisk *": "deny",
      "git push --force-with-lease origin main": "deny",
      "git push -f origin main": "deny",
      "npm publish *": "deny",
      "pnpm publish *": "deny",
      "yarn publish *": "deny",
      "deno publish *": "deny",
      "cargo publish *": "deny",
      "docker system prune -af": "deny"
    },
    "skill": {
      "*": "allow"
    },
    // vault-policy.md が llm-wiki を使って vault を引けと指示する一方、vault は
    // プロジェクト外なので既定では external_directory の許可を求める。非対話の
    // `opencode run` はそれを自動拒否するため、許可が無いと規則が空振りする。
    // ここが ~ なのは、permission のマッチャが {env:HOME} 置換ではなく自前の
    // ~ 展開を通すため。このファイルの他の箇所と表記が違うのはそのせい。
    "external_directory": {
      "~/Documents/Main/**": "allow"
    }
  },

  // 自動更新は Claude 側 (DISABLE_AUTOUPDATER=1) と方針を揃える
  "autoupdate": false,

  // 会話共有はデフォルトで無効
  "share": "disabled"
}
